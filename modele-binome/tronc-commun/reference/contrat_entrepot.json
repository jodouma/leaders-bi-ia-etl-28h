{
  "version_contrat": 1,
  "mission": "tronc-commun",
  "entreprise": "Maison Zitouna",
  "grain": "une ligne de ticket de caisse",
  "unite_monetaire": "millimes entiers (1 TND = 1 000 millimes)",
  "fichiers": {
    "entrepot": "entrepot.sqlite",
    "rejets": "rejets.csv",
    "export": "export",
    "manifest": "export/manifest.json",
    "app": "app/index.html"
  },
  "ordre_tables": [
    "dim_date",
    "dim_produit",
    "dim_boutique",
    "fact_vente",
    "fact_retour"
  ],
  "tables": {
    "dim_date": {
      "role": "dimension",
      "cle": "date_key",
      "cle_metier": null,
      "colonnes": [
        "date_key",
        "date_complete",
        "annee",
        "mois",
        "jour"
      ],
      "colonnes_entieres": [
        "date_key",
        "annee",
        "mois",
        "jour"
      ],
      "colonnes_nullables": [],
      "cles_etrangeres": {}
    },
    "dim_produit": {
      "role": "dimension",
      "cle": "produit_key",
      "cle_metier": "produit_id",
      "colonnes": [
        "produit_key",
        "produit_id",
        "nom",
        "famille",
        "prix_millimes",
        "cout_achat_millimes"
      ],
      "colonnes_entieres": [
        "produit_key",
        "prix_millimes",
        "cout_achat_millimes"
      ],
      "colonnes_nullables": [],
      "cles_etrangeres": {}
    },
    "dim_boutique": {
      "role": "dimension_scd2",
      "cle": "boutique_key",
      "cle_metier": "boutique_id",
      "colonnes": [
        "boutique_key",
        "boutique_id",
        "nom",
        "zone",
        "valid_from",
        "valid_to"
      ],
      "colonnes_entieres": [
        "boutique_key"
      ],
      "colonnes_nullables": [
        "valid_to"
      ],
      "cles_etrangeres": {}
    },
    "fact_vente": {
      "role": "fait",
      "cle": "ligne_id",
      "cle_metier": null,
      "colonnes": [
        "ligne_id",
        "date_key",
        "produit_key",
        "boutique_key",
        "quantite",
        "prix_unitaire_millimes",
        "montant_brut_millimes"
      ],
      "colonnes_entieres": [
        "date_key",
        "produit_key",
        "boutique_key",
        "quantite",
        "prix_unitaire_millimes",
        "montant_brut_millimes"
      ],
      "colonnes_nullables": [],
      "cles_etrangeres": {
        "date_key": "dim_date.date_key",
        "produit_key": "dim_produit.produit_key",
        "boutique_key": "dim_boutique.boutique_key"
      }
    },
    "fact_retour": {
      "role": "fait",
      "cle": "retour_id",
      "cle_metier": null,
      "colonnes": [
        "retour_id",
        "date_key",
        "produit_key",
        "boutique_key",
        "quantite",
        "montant_millimes"
      ],
      "colonnes_entieres": [
        "date_key",
        "produit_key",
        "boutique_key",
        "quantite",
        "montant_millimes"
      ],
      "colonnes_nullables": [],
      "cles_etrangeres": {
        "date_key": "dim_date.date_key",
        "produit_key": "dim_produit.produit_key",
        "boutique_key": "dim_boutique.boutique_key"
      }
    }
  },
  "faits": [
    "fact_vente",
    "fact_retour"
  ],
  "dimension_date": {
    "table": "dim_date",
    "cle": "date_key",
    "date": "date_complete",
    "debut": "2026-01-01",
    "regle": "une ligne par jour, du 2026-01-01 au dernier jour du dernier lot chargé"
  },
  "scd2": {
    "table": "dim_boutique",
    "cle": "boutique_key",
    "cle_metier": "boutique_id",
    "attribut": "zone",
    "valid_from": "valid_from",
    "valid_to": "valid_to",
    "regle": "valid_from inclus, valid_to exclu, valid_to NULL = version courante",
    "faits": [
      {
        "table": "fact_vente",
        "colonne": "boutique_key",
        "date_key": "date_key"
      },
      {
        "table": "fact_retour",
        "colonne": "boutique_key",
        "date_key": "date_key"
      }
    ],
    "frontieres": [
      {
        "cle_metier": "NBE",
        "date": "2026-06-30"
      },
      {
        "cle_metier": "NBE",
        "date": "2026-07-14"
      },
      {
        "cle_metier": "NBE",
        "date": "2026-07-15"
      },
      {
        "cle_metier": "TUN",
        "date": "2026-07-15"
      }
    ]
  },
  "vue_analyse": "SELECT printf('%04d-%02d', d.annee, d.mois) AS mois, d.date_complete AS jour, b.boutique_id, b.zone, p.produit_id, p.famille, f.montant_brut_millimes AS brut, 0 AS retour, f.quantite * p.cout_achat_millimes AS cout_vendu, 0 AS cout_retour, f.quantite AS unites_vendues, 0 AS unites_retournees FROM fact_vente f JOIN dim_date d ON d.date_key = f.date_key JOIN dim_boutique b ON b.boutique_key = f.boutique_key JOIN dim_produit p ON p.produit_key = f.produit_key UNION ALL SELECT printf('%04d-%02d', d.annee, d.mois), d.date_complete, b.boutique_id, b.zone, p.produit_id, p.famille, 0, r.montant_millimes, 0, r.quantite * p.cout_achat_millimes, 0, r.quantite FROM fact_retour r JOIN dim_date d ON d.date_key = r.date_key JOIN dim_boutique b ON b.boutique_key = r.boutique_key JOIN dim_produit p ON p.produit_key = r.produit_key",
  "indicateurs": [
    {
      "code": "ventes_brutes_millimes",
      "libelle": "Ventes brutes",
      "unite": "millimes",
      "formule": "somme de quantite × prix_unitaire des lignes de ticket acceptées",
      "sql": "SUM(brut)",
      "tolerance": 0.0,
      "principal": true
    },
    {
      "code": "retours_millimes",
      "libelle": "Retours",
      "unite": "millimes",
      "formule": "somme des montants remboursés des retours VALIDE acceptés",
      "sql": "SUM(retour)",
      "tolerance": 0.0,
      "principal": true
    },
    {
      "code": "ventes_nettes_millimes",
      "libelle": "Ventes nettes",
      "unite": "millimes",
      "formule": "ventes brutes − retours",
      "sql": "SUM(brut) - SUM(retour)",
      "tolerance": 0.0,
      "principal": true
    },
    {
      "code": "cout_achat_net_millimes",
      "libelle": "Coût d'achat des unités nettes",
      "unite": "millimes",
      "formule": "(unités vendues − unités retournées) × coût d'achat unitaire, produit par produit",
      "sql": "SUM(cout_vendu) - SUM(cout_retour)",
      "tolerance": 0.0,
      "principal": false
    },
    {
      "code": "marge_cout_achat_millimes",
      "libelle": "Marge sur coût d'achat",
      "unite": "millimes",
      "formule": "ventes nettes − coût d'achat des unités nettes",
      "sql": "SUM(brut) - SUM(retour) - SUM(cout_vendu) + SUM(cout_retour)",
      "tolerance": 0.0,
      "principal": true
    },
    {
      "code": "taux_retour",
      "libelle": "Taux de retour",
      "unite": "ratio",
      "formule": "retours / ventes brutes (en montant)",
      "sql": "ROUND(1.0 * SUM(retour) / NULLIF(SUM(brut), 0), 6)",
      "tolerance": 0.0001,
      "principal": true
    },
    {
      "code": "unites_nettes",
      "libelle": "Unités nettes",
      "unite": "nombre",
      "formule": "unités vendues − unités retournées",
      "sql": "SUM(unites_vendues) - SUM(unites_retournees)",
      "tolerance": 0.0,
      "principal": false
    }
  ],
  "axes": {
    "par_zone": "zone",
    "par_boutique": "boutique_id",
    "par_mois": "mois",
    "par_famille": "famille"
  },
  "rejets": {
    "colonnes_obligatoires": [
      "lot",
      "source",
      "numero_ligne",
      "motif"
    ],
    "motifs": [
      "id_conflit",
      "id_manquant",
      "cle_inconnue",
      "quantite_invalide"
    ],
    "motifs_toleres": [
      "doublon_exact"
    ],
    "sources": [
      "operations.sqlite",
      "ventes.csv"
    ],
    "etape_rejets": {
      "sources": [
        "ventes.csv"
      ]
    }
  },
  "export": {
    "tables": [
      "dim_date",
      "dim_produit",
      "dim_boutique",
      "fact_vente",
      "fact_retour"
    ],
    "sommes": {
      "fact_vente": [
        "quantite",
        "montant_brut_millimes"
      ],
      "fact_retour": [
        "quantite",
        "montant_millimes"
      ],
      "dim_produit": [
        "prix_millimes",
        "cout_achat_millimes"
      ]
    },
    "format": "CSV UTF-8, séparateur virgule, en-tête = noms de colonnes"
  },
  "app": {
    "textes_obligatoires": [
      "Vue direction",
      "Détail par boutique",
      "Qualité des données"
    ],
    "taille_max_octets": 5000000
  },
  "lots": {
    "lot1": {
      "etape": "initial",
      "attendu": "attendu_lot1.json",
      "debut": "2026-01-01",
      "fin": "2026-06-30"
    },
    "lot2": {
      "etape": "increment",
      "attendu": "attendu_lot2.json",
      "debut": "2026-07-01",
      "fin": "2026-08-31"
    }
  },
  "etapes": {
    "initial": "lot1",
    "increment": "lot2",
    "rejeu": "lot2"
  }
}
