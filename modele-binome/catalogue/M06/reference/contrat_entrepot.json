{
  "version_contrat": 1,
  "mission": "M06",
  "entreprise": "Dar Azur",
  "grain": "un séjour (une réservation de chambre, de la date d'arrivée à la date de départ)",
  "unite_monetaire": "millimes entiers (1 TND = 1 000 millimes)",
  "fichiers": {
