table dim_date
	lineageTag: fef924a0-a157-53a9-9263-a6ce7dc6f25c

	column date_key
		dataType: int64
		sourceColumn: date_key
		summarizeBy: none

	column full_date
		dataType: dateTime
		sourceColumn: full_date
		summarizeBy: none
		formatString: yyyy-mm-dd
		annotation UnderlyingDateTimeDataType = Date

	column year
		dataType: int64
		sourceColumn: year
		summarizeBy: none

	column month
		dataType: int64
		sourceColumn: month
		summarizeBy: none

	column day
		dataType: int64
		sourceColumn: day
		summarizeBy: none

	partition dim_date = m
		mode: import
		source =
			let
			    Source = Csv.Document(File.Contents(CSVFolder & "\dim_date.csv"), [Delimiter=",", Columns=5, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
			    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
			    Typed = Table.TransformColumnTypes(Headers, {{"date_key", Int64.Type}, {"full_date", type date}, {"year", Int64.Type}, {"month", Int64.Type}, {"day", Int64.Type}}, "en-US")
			in
			    Typed

	annotation PBI_ResultType = Table
